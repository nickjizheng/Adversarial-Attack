# Required for scripts that call OpenAI through langchain-openai.
OPENAI_API_KEY=your_api_key_here

# Model used by the assistant reasoning steps.
OPENAI_MODEL=gpt-4o

# Validation split arranged as class-name folders containing .mp4/.avi files.
VALIDATION_DATA_DIR=./data/validation

# Full UCF101 dataset root used by src/fine_tune.py.
UCF101_DATA_DIR=./data/UCF101

# Local checkpoint used by evaluation scripts.
MODEL_CHECKPOINT=./checkpoints/fine_tuned_resnet18.pth

# Output locations for generated plots/checkpoints.
OUTPUT_DIR=./outputs
CHECKPOINT_DIR=./checkpoints

